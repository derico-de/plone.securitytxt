<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="plone.securitytxt">

  <browser:viewlet
      name="securitypolicywarning"
      for="*"
      layer="plone.securitytxt.interfaces.IPloneSecuritytxtLayer"
      manager="plone.app.layout.viewlets.interfaces.IPortalHeader"
      class=".security_policy_warning.SecurityPolicyWarning"
      permission="plone.securitytxt.ManageSecurityPolicy"
      />

</configure>
