<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="plone.securitytxt">

  <plone:service
      method="GET"
      for="plone.base.interfaces.IPloneSiteRoot"
      factory=".security_policy.SecurityPolicyService"
      name="@security-policy"
      permission="plone.securitytxt.ManageSecurityPolicy"
      />

  <plone:service
      method="POST"
      for="plone.base.interfaces.IPloneSiteRoot"
      factory=".security_policy.SecurityPolicyService"
      name="@security-policy"
      permission="plone.securitytxt.ManageSecurityPolicy"
      />

  <plone:service
      method="PATCH"
      for="plone.base.interfaces.IPloneSiteRoot"
      factory=".security_policy.SecurityPolicyService"
      name="@security-policy"
      permission="plone.securitytxt.ManageSecurityPolicy"
      />

</configure>
