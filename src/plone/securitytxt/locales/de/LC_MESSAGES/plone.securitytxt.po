#: ../policy.py:447
msgid "Bug-Bounty may occur at most once."
msgstr "Bug-Bounty darf höchstens einmal vorkommen."

#: ../policy.py:427
msgid "Bug-Bounty must be True or False."
msgstr "Bug-Bounty muss True oder False sein."

#: ../policy.py:419
msgid "CSAF must contain an HTTPS URI."
msgstr "CSAF muss eine HTTPS-URI enthalten."

#: ../controlpanels/security_policy.py:97
msgid "Canonical"
msgstr "Kanonische URL"

#: ../controlpanels/security_policy.py:103
msgid "Canonical HTTPS URL"
msgstr "Kanonische HTTPS-URL"

#: ../policy.py:319
msgid "Canonical URLs must be credential-free HTTPS well-known URLs without query or fragment."
msgstr "Kanonische URLs müssen HTTPS-well-known-URLs ohne Zugangsdaten, Abfrage und Fragment sein."

#: ../policy.py:501
msgid "Canonical is recommended."
msgstr "Eine kanonische URL wird empfohlen."

#: ../controlpanels/security_policy.py:146
msgid "Choose unsigned output or output signed by a configured profile."
msgstr "Wählen Sie eine unsignierte Ausgabe oder eine mit einem konfigurierten Profil signierte Ausgabe."

#: ../controlpanels/security_policy.py:89
msgid "Comma-separated BCP 47 language tags, in preference order. Common values: en (English), de (German), de-CH (German as used in Switzerland), or fr (French). Example: en, de-CH"
msgstr "Kommagetrennte BCP-47-Sprachkennzeichnungen in bevorzugter Reihenfolge. Häufige Werte: en (Englisch), de (Deutsch), de-CH (Deutsch in der Schweiz) oder fr (Französisch). Beispiel: de, en"

