#: ../controlpanels/security_policy.py:342
msgid "${errors} errors, ${blockers} publication blockers, ${warnings} warnings."
msgstr "${errors} Fehler, ${blockers} Veröffentlichungshindernisse, ${warnings} Warnungen."

#: ../policy.py:386
msgid "${name} is a first-class field."
msgstr "${name} ist ein Standardfeld."

#: ../policy.py:435
msgid "${name} is not in this release's IANA snapshot."
msgstr "${name} ist nicht im IANA-Stand dieser Version enthalten."

#: ../policy.py:394
msgid "${name} needs a nonempty single-line value."
msgstr "${name} benötigt einen nicht leeren einzeiligen Wert."

#: ../policy.py:334
msgid "${tag} is not a supported BCP 47 language tag."
msgstr "${tag} ist keine unterstützte BCP-47-Sprachkennzeichnung."

#: ../configure.zcml:27
msgid "A Plone addon to generate and provide a security.txt for the Plone website."
msgstr "Eine Plone-Erweiterung zum Erzeugen und Bereitstellen einer security.txt für die Plone-Website."

#: ../policy.py:557
msgid "A generated line exceeds 2,048 characters."
msgstr "Eine erzeugte Zeile überschreitet 2.048 Zeichen."

