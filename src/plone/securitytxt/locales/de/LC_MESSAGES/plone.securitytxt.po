msgid "Acknowledgments"
msgstr "Danksagungen"

#: ../controlpanels/security_policy.py:118
msgid "Acknowledgments URI"
msgstr "Danksagungs-URI"

#: ../policy.py:477
msgid "At least one Contact is required."
msgstr "Mindestens ein Kontakt ist erforderlich."

