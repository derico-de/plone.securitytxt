msgstr "Nicht festgelegt"

#: ../controlpanels/security_policy.py:137
msgid "One Field-Name: value row per line. Examples: Bug-Bounty: True or CSAF: https://example.com/.well-known/csaf/provider-metadata.json"
msgstr "Eine Zeile im Format Feldname: Wert pro Eintrag. Beispiele: Bug-Bounty: True oder CSAF: https://example.com/.well-known/csaf/provider-metadata.json"

#: ../controlpanels/security_policy.py:114
msgid "One acknowledgments URI per line. Example: https://example.com/security/acknowledgments"
msgstr "Eine URI für Danksagungen pro Zeile. Beispiel: https://example.com/security/acknowledgments"

#: ../controlpanels/security_policy.py:73
msgid "One contact URI per line, in preference order. Examples: mailto:security@example.com or https://example.com/security/contact"
msgstr "Eine Kontakt-URI pro Zeile in bevorzugter Reihenfolge. Beispiele: mailto:security@example.com oder https://example.com/security/contact"

#: ../controlpanels/security_policy.py:108
msgid "One encryption-key URI per line. Example: https://example.com/pgp-key.txt"
msgstr "Eine URI für den Verschlüsselungsschlüssel pro Zeile. Beispiel: https://example.com/pgp-key.txt"

#: ../controlpanels/security_policy.py:131
msgid "One security-jobs URI per line. Example: https://example.com/security/jobs"
msgstr "Eine URI für Stellenangebote im Sicherheitsbereich pro Zeile. Beispiel: https://example.com/security/jobs"

#: ../controlpanels/security_policy.py:123
msgid "One security-policy URI per line. Example: https://example.com/security/policy"
msgstr "Eine URI für die Sicherheitsrichtlinie pro Zeile. Beispiel: https://example.com/security/policy"

