<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:zcml="http://namespaces.zope.org/zcml"
  i18n_domain="plone.securitytxt">

  <configure zcml:condition="installed AccessControl.security">
    <permission
        id="plone.securitytxt.ManageSecurityPolicy"
        title="Manage Security Policy"
        />
  </configure>

</configure>
